{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Rota Dev API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "me-controller" ]
      }
    },
    "/api/profile" : {
      "get" : {
        "operationId" : "current",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "profile-controller" ]
      }
    },
    "/api/profile/snapshots/{id}" : {
      "get" : {
        "operationId" : "snapshot",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SnapshotResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "profile-controller" ]
      }
    },
    "/api/sources" : {
      "get" : {
        "operationId" : "list_1",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/SourceResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "sources-controller" ]
      }
    },
    "/api/sources/github/sync" : {
      "post" : {
        "operationId" : "syncGithub",
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "tags" : [ "sources-controller" ]
      }
    },
    "/api/sources/uploads" : {
      "get" : {
        "operationId" : "list",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/UploadResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "uploads-controller" ]
      },
      "post" : {
        "operationId" : "create",
        "parameters" : [ {
          "in" : "query",
          "name" : "kind",
          "required" : true,
          "schema" : {
            "type" : "string",
            "enum" : [ "LINKEDIN", "RESUME" ]
          }
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "format" : "binary"
                  }
                },
                "required" : [ "file" ]
              }
            }
          }
        },
        "responses" : {
          "202" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UploadResponse"
                }
              }
            },
            "description" : "Accepted"
          }
        },
        "tags" : [ "uploads-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "EvidenceResponse" : {
        "type" : "object",
        "properties" : {
          "confidence" : {
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "kind" : {
            "type" : "string"
          },
          "skill" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "url" : {
            "type" : "string"
          }
        },
        "required" : [ "confidence", "id", "kind", "title" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "avatarUrl" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "login" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "timeZone" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "login", "timeZone" ]
      },
      "ProfileResponse" : {
        "type" : "object",
        "properties" : {
          "snapshots" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SnapshotResponse"
            }
          }
        },
        "required" : [ "snapshots" ]
      },
      "SkillResponse" : {
        "type" : "object",
        "properties" : {
          "confidence" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "weight" : {
            "type" : "number",
            "format" : "double"
          }
        },
        "required" : [ "confidence", "name", "weight" ]
      },
      "SnapshotResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "evidences" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EvidenceResponse"
            }
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "skills" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SkillResponse"
            }
          },
          "sourceType" : {
            "type" : "string"
          }
        },
        "required" : [ "createdAt", "evidences", "id", "skills", "sourceType" ]
      },
      "SourceResponse" : {
        "type" : "object",
        "properties" : {
          "connectedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "externalLogin" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lastSyncedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "connectedAt", "id", "type" ]
      },
      "UploadResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "format" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "kind" : {
            "type" : "string"
          },
          "originalName" : {
            "type" : "string"
          },
          "sizeBytes" : {
            "type" : "integer",
            "format" : "int64"
          },
          "status" : {
            "type" : "string"
          }
        },
        "required" : [ "createdAt", "format", "id", "kind", "originalName", "sizeBytes", "status" ]
      }
    }
  }
}
