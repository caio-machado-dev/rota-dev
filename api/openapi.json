{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Rota Dev API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "me-controller" ]
      }
    },
    "/api/sources" : {
      "get" : {
        "operationId" : "list",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/SourceResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "sources-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "avatarUrl" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "login" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "timeZone" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "login", "timeZone" ]
      },
      "SourceResponse" : {
        "type" : "object",
        "properties" : {
          "connectedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "externalLogin" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lastSyncedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "connectedAt", "id", "type" ]
      }
    }
  }
}
