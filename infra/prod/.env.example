# Copie para /opt/rota-dev/.env na VPS (chmod 600). Nunca versione o .env.
# Sha completo do commit da main a implantar (o workflow "release" publica as imagens com essa tag).
ROTA_VERSION=

POSTGRES_DB=rotadev
POSTGRES_USER=rotadev
# openssl rand -base64 32
POSTGRES_PASSWORD=

# OAuth App de PRODUÇÃO (separada da de desenvolvimento), com callback
# https://<dominio>/api/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# openssl rand -base64 32. Guarde uma cópia fora da VPS: perder a chave obriga todo mundo a reconectar o GitHub.
ROTA_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=

# Backup (backup.sh): remote do rclone já configurado para o R2 ou B2, e quantos dias manter.
BACKUP_REMOTE=r2:rota-dev-backups
BACKUP_RETENTION_DAYS=30
