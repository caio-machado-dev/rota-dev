# Copie para infra/.env e ajuste. O .env nunca vai para o git.
POSTGRES_DB=rotadev
POSTGRES_USER=rotadev
POSTGRES_PASSWORD=troque-esta-senha
# Mude se a porta 5432 já estiver em uso na sua máquina.
POSTGRES_PORT=5432
# OAuth App do GitHub (github.com/settings/developers).
# Callback local: http://localhost:3000/api/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Chave que cifra os tokens OAuth no banco (ADR 0008). Gere com: openssl rand -base64 32
# Perder a chave = os usuários precisam logar de novo no GitHub. Nunca reutilize a de desenvolvimento.
ROTA_ENCRYPTION_KEY=
# IA do diagnóstico e do plano (ADR 0016). Padrão: OpenRouter com um modelo gratuito.
# Crie a chave em https://openrouter.ai/keys (grátis, sem cartão).
ROTA_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Opcional: outro modelo do OpenRouter (os terminados em ":free" não custam nada).
# ROTA_AI_OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Só se ROTA_AI_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
